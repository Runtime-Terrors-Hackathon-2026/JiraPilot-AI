{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationResponse",
  "type": "object",
  "required": ["ticket_key", "is_complete", "readiness_score", "missing_fields", "identified_fields", "comment_template", "notification_needed"],
  "properties": {
    "ticket_key": { "type": "string" },
    "is_complete": { "type": "boolean" },
    "readiness_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "identified_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comment_template": { "type": "string" },
    "notification_needed": { "type": "boolean" }
  }
}
