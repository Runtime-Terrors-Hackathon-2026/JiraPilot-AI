{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceCatalog",
  "type": "object",
  "required": ["organization", "catalogVersion", "description", "groups"],
  "properties": {
    "organization": { "type": "string" },
    "catalogVersion": { "type": "string" },
    "description": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "leadArchitect", "services"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "leadArchitect": { "type": "string" },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "tier", "ownerTeam", "purpose", "healthEndpoint", "dependencies", "endpoints", "failureModes"],
              "properties": {
                "name": { "type": "string" },
                "tier": { "type": "string" },
                "ownerTeam": { "type": "string" },
                "purpose": { "type": "string" },
                "healthEndpoint": { "type": "string" },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "endpoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["method", "path", "description", "requestSchema", "responseSchema"],
                    "properties": {
                      "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                      "path": { "type": "string" },
                      "description": { "type": "string" },
                      "requestSchema": { "type": "object" },
                      "responseSchema": { "type": "object" }
                    }
                  }
                },
                "failureModes": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
