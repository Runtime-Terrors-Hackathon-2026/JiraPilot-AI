# JiraPilot AI - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Mode
DEMO_MODE=true
APP_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (Defaults to embedded H2 if PostgreSQL not running)
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/jirapilot
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Atlassian Jira Cloud Configuration (Required only when DEMO_MODE=false)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=HACK

# AI Provider Configuration (Optional - Demo mode includes deterministic intelligence)
AI_PROVIDER=deterministic
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# Email Notification Configuration (Mock Email Viewer is active by default in dashboard)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=jirapilot-ai@example.com
EMAIL_ENABLED=true
