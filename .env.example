# JiraPilot AI - Enterprise Environment Configuration
# Northstar Digital Systems Synthetic Architecture Demo
# Copy this file to .env and configure as needed.

# Application Mode
DEMO_MODE=true
APP_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (Defaults to embedded H2 if PostgreSQL not running)
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/jirapilot
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Atlassian Jira Cloud Configuration (Required only when DEMO_MODE=false)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=NOVA

# Python AI Service & NVIDIA NIM Configuration
AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# EmailJS Notification Service Configuration
EMAILJS_ENABLED=false
EMAILJS_SERVICE_ID=service_jirapilot
EMAILJS_TEMPLATE_ID=template_rca_alert
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_DEFAULT_RECIPIENT=oncall@northstar-digital.example
EMAILJS_ALLOWED_RECIPIENTS=example.com,northstar.io,oncall@northstar-digital.example

# Traditional SMTP Configuration (Optional fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=jirapilot-ai@example.com
EMAIL_ENABLED=true
